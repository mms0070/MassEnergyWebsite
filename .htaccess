# Mass Energy - server settings for Apache / LiteSpeed hosting

# 1. Keep the TEST copy out of search results.
#    This only matches test.bahriatownservices.com. On www.massenergy.pk the
#    header is not sent, so the real site stays fully indexable.
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host "^test\.bahriatownservices\.com$" STAGING_HOST
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=STAGING_HOST
</IfModule>

# 2. Branded "page not found" page (still returns a proper 404 status)
ErrorDocument 404 /404.html

# 3. Browser caching. Images and fonts are cached for a year (give a replaced
#    image a new file name). CSS and JS are cached for 30 days; bump the ?v=
#    number in index.html whenever they change. HTML is always re-checked.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 4. Correct file types for modern formats
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType application/manifest+json .webmanifest
</IfModule>
